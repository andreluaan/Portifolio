# Netlify cache rules. Files in /_astro carry a content hash in their name, so they never change in place.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Images keep their names between deploys (a repainted one would go stale): cached for a day only,
# then revalidated in the background.
/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
